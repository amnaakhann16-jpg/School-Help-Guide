# School Help Guide — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Your IBM Cloud API key.
# Generate one at: cloud.ibm.com → Manage → Access (IAM) → API keys → Create
# Save it immediately — IBM only shows it once.
OPENAI_API_KEY=your-ibm-cloud-api-key-here

# Your watsonx.ai project ID (the sandbox project is created automatically).
# Find it at: dataplatform.cloud.ibm.com → open your project → Manage tab → Project ID
WATSONX_PROJECT_ID=your-project-id-here

# ── Optional — only change if your Runtime service is in a different region ──

# watsonx.ai Runtime endpoint. Dallas (us-south) is the default.
# Other regions: eu-de, eu-gb, jp-tok, au-syd, ca-tor
OPENAI_BASE_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model used for School Help Guide.
MODEL_NAME=ibm/granite-4-h-small
